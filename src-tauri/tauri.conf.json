{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ciyuan Codex",
  "mainBinaryName": "ciyuan-codex",
  "version": "1.0.0",
  "identifier": "io.github.ccfwwm.ciyuan-codex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "词元互联 Codex",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true,
        "shadow": false,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420 ws://localhost:1420; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 ccfwwm; based on Codex App Manager by Wangnov",
    "shortDescription": "Ciyuan Sub2API account and Codex desktop manager.",
    "longDescription": "Sign in to Ciyuan, choose a model, and connect Codex with one click. Includes desktop installation, updates and skins.",
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "resources": [
      "resources/*"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign-windows-authenticode.ps1",
          "-Path",
          "%1"
        ]
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "French",
          "German",
          "Spanish",
          "PortugueseBR",
          "Russian",
          "Arabic"
        ],
        "customLanguageFiles": {
          "English": "installer/languages/English.nsh",
          "SimpChinese": "installer/languages/SimpChinese.nsh",
          "TradChinese": "installer/languages/TradChinese.nsh",
          "Japanese": "installer/languages/Japanese.nsh",
          "Korean": "installer/languages/Korean.nsh",
          "French": "installer/languages/French.nsh",
          "German": "installer/languages/German.nsh",
          "Spanish": "installer/languages/Spanish.nsh",
          "PortugueseBR": "installer/languages/PortugueseBR.nsh",
          "Russian": "installer/languages/Russian.nsh",
          "Arabic": "installer/languages/Arabic.nsh"
        }
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0RUQ2QkJGMDg0Mjk0ODUKUldTRmxFSUl2MnZ0eExnZ1BiM0srVW9WSkRVRWhSbVZOdE5jUFIyeGdzMElKWTNiM29aeVhNcWUK",
      "endpoints": [
        "https://github.com/ccfwwm/ciyuan-codex/releases/latest/download/latest.json"
      ]
    }
  }
}
